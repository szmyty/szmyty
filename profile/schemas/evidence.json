{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/szmyty/szmyty/profile/schemas/evidence.json",
  "title": "EvidenceCatalog",
  "description": "Schema for profile/content/evidence.yml",
  "type": "object",
  "required": ["records"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "evidence_type",
          "status",
          "sensitivity",
          "last_reviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable kebab-case identifier."
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "Candidate claim text as it might appear in a profile."
          },
          "evidence_type": {
            "type": "string",
            "enum": ["url", "repo-path", "self-reported", "inferred", "none"]
          },
          "url": {
            "type": ["string", "null"],
            "description": "Public URL to the evidence artifact."
          },
          "repo_path": {
            "type": ["string", "null"],
            "description": "Repository-relative path to the artifact."
          },
          "status": {
            "type": "string",
            "enum": ["verified", "needs-user-verification", "excluded"]
          },
          "sensitivity": {
            "type": "string",
            "enum": ["public", "sensitive", "internal"]
          },
          "last_reviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
