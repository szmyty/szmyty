###############################################################################
# .gitattributes
#
# Ego Hygiene Engineering Standard
#
# Purpose
# -------
# Provides consistent Git behavior across operating systems while improving
# diffs, repository statistics, and contributor experience.
#
# Design Goals
# ------------
# • Cross-platform consistency
# • LF as the canonical repository line ending
# • Preserve CRLF where Windows tooling requires it
# • Human-friendly diffs
# • Correct binary detection
# • Helpful GitHub Linguist classification
#
# Documentation
# -------------
# https://git-scm.com/docs/gitattributes
###############################################################################

###############################################################################
# Global Defaults
###############################################################################

# Normalize all text files to LF within the repository.
* text=auto eol=lf

###############################################################################
# Shell & Scripts
###############################################################################

*.sh                text eol=lf
*.bash              text eol=lf
*.zsh               text eol=lf
*.fish              text eol=lf

*.bat               text eol=crlf
*.cmd               text eol=crlf

# PowerShell
*.ps1    text eol=lf
*.psm1   text eol=lf
*.psd1   text eol=lf
*.ps1xml text eol=lf
*.pssc   text eol=lf
*.psrc   text eol=lf
*.cdxml  text eol=lf

###############################################################################
