{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash scripts/copilot-hooks/session-start.sh",
        "powershell": "pwsh -NonInteractive -File scripts/copilot-hooks/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash scripts/copilot-hooks/pre-tool-use.sh",
        "powershell": "pwsh -NonInteractive -File scripts/copilot-hooks/pre-tool-use.ps1",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "bash scripts/copilot-hooks/error-occurred.sh",
        "powershell": "pwsh -NonInteractive -File scripts/copilot-hooks/error-occurred.ps1",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
