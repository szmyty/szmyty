{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Typography tokens defining font primitives and semantic text roles for all magazine components",
  "font": {
    "family": {
      "serif": {
        "$value": "\"Crimson Text\", Georgia, 'Times New Roman', serif",
        "$type": "fontFamily",
        "$description": "Primary editorial body font; classic print readability"
      },
      "sans": {
        "$value": "'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Utility and caption font; clean contrast to serif body"
      },
      "mono": {
        "$value": "'Courier New', Courier, monospace",
        "$type": "fontFamily",
        "$description": "Code, metadata, and typewriter-style accent text"
      },
      "display": {
        "$value": "\"Bebas Neue\", sans-serif",
        "$type": "fontFamily",
        "$description": "Headline / display font"
      }
    },
    "size": {
      "xs": {
        "$value": "10px",
        "$type": "dimension",
        "$description": "Caption, footnotes, and fine print"
      },
      "sm": {
        "$value": "12px",
        "$type": "dimension",
        "$description": "Supporting text, labels, and pull-quotes"
      },
      "md": {
        "$value": "16px",
        "$type": "dimension",
        "$description": "Base body copy size"
      },
      "lg": {
        "$value": "20px",
        "$type": "dimension",
        "$description": "Sub-heading and intro paragraph"
      },
      "xl": {
        "$value": "28px",
        "$type": "dimension",
        "$description": "Section heading"
      },
      "2xl": {
        "$value": "40px",
        "$type": "dimension",
        "$description": "Page title and article headline"
      },
      "3xl": {
        "$value": "56px",
        "$type": "dimension",
        "$description": "Cover / hero display headline"
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight",
        "$description": "Default body weight"
      },
      "medium": {
        "$value": "500",
        "$type": "fontWeight",
        "$description": "Emphasis and sub-headings"
      },
      "bold": {
        "$value": "700",
        "$type": "fontWeight",
        "$description": "Strong headings and key callouts"
      },
      "black": {
        "$value": "900",
        "$type": "fontWeight",
        "$description": "Display-level headlines"
      }
    },
    "lineHeight": {
      "tight": {
        "$value": "1.2",
        "$type": "number",
        "$description": "Headlines and large display text"
      },
      "snug": {
        "$value": "1.4",
        "$type": "number",
        "$description": "Sub-headings and pull-quotes"
      },
      "normal": {
        "$value": "1.6",
        "$type": "number",
        "$description": "Standard body copy"
      },
      "relaxed": {
        "$value": "1.8",
        "$type": "number",
        "$description": "Long-form editorial text requiring extra breathing room"
      }
    },
    "letterSpacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension",
        "$description": "Large display headings"
      },
      "normal": {
        "$value": "0em",
        "$type": "dimension",
        "$description": "Default body text"
      },
      "wide": {
        "$value": "0.06em",
        "$type": "dimension",
        "$description": "All-caps labels and small text"
      },
      "wider": {
        "$value": "0.12em",
        "$type": "dimension",
        "$description": "Section titles and decorative text"
      }
    }
  },
  "role": {
    "$description": "Semantic text roles that compose font primitives into reusable typography styles",
    "display": {
      "$description": "Page titles and cover headlines — maximum visual impact; font family finalized during component phase",
      "fontFamily": {
        "$value": "{font.family.display}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.black}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.3xl}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.tight}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.tight}",
        "$type": "dimension"
      }
    },
    "heading": {
      "$description": "Section headers and article titles — clear hierarchy marker using the editorial serif",
      "fontFamily": {
        "$value": "{font.family.serif}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.bold}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.xl}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.snug}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.normal}",
        "$type": "dimension"
      }
    },
    "body": {
      "$description": "Main editorial text and practice prompts — optimised for sustained reading comfort",
      "fontFamily": {
        "$value": "{font.family.serif}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.regular}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.md}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.normal}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.normal}",
        "$type": "dimension"
      }
    },
    "caption": {
      "$description": "Captions, metadata, labels, and footnotes — supplementary information at reduced scale",
      "fontFamily": {
        "$value": "{font.family.sans}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.regular}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.xs}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.snug}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.wide}",
        "$type": "dimension"
      }
    },
    "tagline": {
      "$description": "Cover tagline — the single-line atmospheric phrase beneath the edition label; retro emphasis sans-serif at medium weight, as observed on the reference cover ('A Mystic Guide for Self-Maintenance')",
      "fontFamily": {
        "$value": "{font.family.sans}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.medium}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.sm}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.snug}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.wider}",
        "$type": "dimension"
      }
    },
    "label": {
      "$description": "UI badge and price-tag labels — compact all-caps identifiers such as the price badge ('25¢'), issue badge ('Issue No. 1'), and tone badge ('Scary! Fun!') on the reference cover",
      "fontFamily": {
        "$value": "{font.family.sans}",
        "$type": "fontFamily"
      },
      "fontWeight": {
        "$value": "{font.weight.bold}",
        "$type": "fontWeight"
      },
      "fontSize": {
        "$value": "{font.size.xs}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{font.lineHeight.tight}",
        "$type": "number"
      },
      "letterSpacing": {
        "$value": "{font.letterSpacing.wider}",
        "$type": "dimension"
      }
    }
  }
}
