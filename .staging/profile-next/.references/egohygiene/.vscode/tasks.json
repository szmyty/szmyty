{
    "$schema": "https://json.schemastore.org/task.json",
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup",
            "type": "shell",
            "command": "fvm install --setup && cd apps/egohygiene && fvm flutter pub get",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Generate Code",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter pub run build_runner build --delete-conflicting-outputs && fvm flutter pub run slang",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Analyze",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter analyze",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter test",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build (Web)",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter build web --release",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run (Default Device)",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter run",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run (Chrome)",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter run -d chrome",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "CI Checks (Local)",
            "type": "shell",
            "command": "cd apps/egohygiene && fvm flutter pub get && fvm flutter pub run build_runner build --delete-conflicting-outputs && fvm flutter pub run slang && fvm flutter analyze && fvm flutter test",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
