{
    "configurations": [
        {
            "name": "Flutter: Run (Default Device)",
            "request": "launch",
            "type": "dart",
            "program": "apps/egohygiene/lib/main.dart",
            "cwd": "apps/egohygiene"
        },
        {
            "name": "Flutter: Run (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "apps/egohygiene/lib/main.dart",
            "cwd": "apps/egohygiene",
            "deviceId": "chrome"
        },
        {
            "name": "Flutter: Run Tests (Current File)",
            "request": "launch",
            "type": "dart",
            "program": "${file}",
            "flutterMode": "debug"
        }
    ]
}
